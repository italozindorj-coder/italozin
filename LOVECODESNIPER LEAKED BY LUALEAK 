local function attachHeadlessMesh()
    local character = player.Character
    if not character then return false, "No character" end

    local targetPart = character:FindFirstChild("Head")
    if not targetPart then return false, "Head missing" end

    local oldAsset = character:FindFirstChild("Headless_Headless")
    if oldAsset then oldAsset:Destroy() end

    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then head.Transparency = 1 end

    local assetId = "rbxassetid://134082579"
    local success, objects = pcall(function()
        return game:GetObjects(assetId)
    end)
    if not success or not objects or #objects == 0 then
        return false, "Asset fetch failed"
    end

    local assetModel = objects[1]
    assetModel.Name = "Headless_Headless"

    local mainMesh = assetModel:IsA("BasePart") and assetModel or assetModel:FindFirstChildWhichIsA("BasePart", true)
    if not mainMesh then
        return false, "No MeshPart in asset"
    end

    mainMesh.Size = mainMesh.Size * Vector3.new(1,1,1)
    mainMesh.CanCollide = false
    mainMesh.CFrame = targetPart.CFrame * CFrame.new(0,0,0) * CFrame.Angles(0,0,0)

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = targetPart
    weld.Part1 = mainMesh
    weld.Parent = mainMesh

    assetModel.Parent = character

    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://135315310485417"
    sound.Volume = 0.5
    sound.Parent = mainMesh
    sound:Play()
    game:GetService("Debris"):AddItem(sound, 3)

    return true
end

