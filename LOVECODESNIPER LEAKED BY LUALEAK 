        if getgenv().LoveeCodeSniperNotifyConnection then
            pcall(function() getgenv().LoveeCodeSniperNotifyConnection:Disconnect() end)
            getgenv().LoveeCodeSniperNotifyConnection = nil
        end
        if GUI then GUI:Destroy() end
        stopAntiRagdoll()
        detachHeadlessMesh()
        detachKorbloxLeg("Left")
        detachKorbloxLeg("Right")
        autoBuyStop()
        stopAntiLag()
    end
end

-- Auto-start features if enabled
if _antiRagdollEnabled then startAntiRagdoll() end
if _autoBuyEnabled then autoBuyStart() end
if _antiLagEnabled then startAntiLag() end

-- Apply accessories on load and respawn
local function applyAccessories()
    if _headlessEnabled then attachHeadlessMesh() end
    if _korbloxLeftEnabled then attachKorbloxLeg("Left") end
    if _korbloxRightEnabled then attachKorbloxLeg("Right") end
end

player.CharacterAdded:Connect(function()
    task.wait(0.5)
    applyAccessories()
    if _autoBuyEnabled then
        autoBuyStart() -- restart after respawn
    end
end)

if player.Character then
    applyAccessories()
end